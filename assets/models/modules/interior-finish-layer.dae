  <library_effects>
    <effect id="label_texture_-_callout_-_central_path-effect">
      <profile_COMMON>
        <newparam sid="callout_-_central_path_png-surface">
          <surface type="2D">
            <init_from>callout_-_central_path_png</init_from>
          </surface>
        </newparam>
        <newparam sid="callout_-_central_path_png-sampler">
          <sampler2D>
            <source>callout_-_central_path_png-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="callout_-_central_path_png-sampler" texcoord="label UV"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.45</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
