  <library_effects>
    <effect id="off-the-shelf_window_glass-effect">
      <profile_COMMON>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <color sid="diffuse">0.4941176 0.6980392 0.8235294 1</color>
            </diffuse>
            <transparent opaque="A_ONE">
              <color sid="alpha">0 0 0 0.38</color>
            </transparent>
            <index_of_refraction>
              <float sid="ior">1.45</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
    <effect id="whitewashed_cheap_panels-effect">
      <profile_COMMON>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <color sid="diffuse">0.8862745 0.8627451 0.8 1</color>
            </diffuse>
            <reflectivity>
